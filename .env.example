# Content generation — template mode works with NO API key (default).
# Sites and hourly posts use rotating editorial templates automatically.

# Provider selection: auto | template | groq | openrouter | openai | gemini
# auto picks the first configured key below (recommended: groq — free tier at console.groq.com)
CONTENT_PROVIDER=auto

# Recommended alternative to Gemini (free tier): https://console.groq.com/
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter — one key, many models including free options: https://openrouter.ai/
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemma-2-9b-it:free

# OpenAI — https://platform.openai.com/api-keys
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Google Gemini (optional)
# GEMINI_API_KEY=

# Force template-only mode (no AI calls)
# DISABLE_AI_CONTENT=true

# Monetization primitives
# Generic newsletter webhook receives { email, site, source, createdAt }.
# Use this with Beehiiv/ConvertKit/Mailchimp/Zapier/Make until a direct provider is wired.
# NEWSLETTER_WEBHOOK_URL=

# Affiliate links. AFFILIATE_SEARCH_URL may include {query}; otherwise Amazon search is used.
# AMAZON_ASSOCIATE_TAG=
# AFFILIATE_SEARCH_URL=https://www.amazon.com/s?k={query}
# AFFILIATE_DISCLOSURE=Disclosure: some outbound links may be affiliate or partner links.

# Sponsor slot shown on the main dashboard and every generated site.
# SPONSOR_NAME=
# SPONSOR_URL=
# SPONSOR_TAGLINE=
# SPONSOR_LABEL=Sponsor

# External digital download storefronts promoted across the network.
# ETSY_SHOP_URL=
# GUMROAD_PROFILE_URL=
# SHOPIFY_STORE_URL=
# PAYHIP_STORE_URL=
# LEMONSQUEEZY_STORE_URL=
# KOFI_SHOP_URL=

# Optional but recommended: HMAC secret for customer digital access links.
# If omitted, CRON_SECRET is reused; if neither is set, a local development fallback is used.
# CUSTOMER_ACCESS_SECRET=
